generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum ActivityLogLevel {
  INFO
  WARN
  ERROR
  SUCCESS
}

enum ActivityLogCategory {
  AUTH
  CONNECTION
  SYSTEM
  USER_ACTION
}

model ActivityLog {
  id        Int                 @id @default(autoincrement())
  level     ActivityLogLevel
  category  ActivityLogCategory
  message   String
  username  String?
  ipAddress String?
  metadata  String? // JSON string
  timestamp DateTime            @default(now())

  @@index([username])
  @@index([category])
  @@index([timestamp])
  @@map("activity_logs")
}

model LoginAttempt {
  id        Int      @id @default(autoincrement())
  username  String
  success   Boolean
  ipAddress String?
  userAgent String?
  timestamp DateTime @default(now())
  reason    String? // failure reason

  @@index([username])
  @@index([ipAddress])
  @@index([timestamp])
  @@map("login_attempts")
}

// ─────────────────────────────────────────
// Full User Login → Logout Session
// Tracks every authenticated session lifecycle
// ─────────────────────────────────────────
enum UserSessionLogoutReason {
  MANUAL
  TIMEOUT
  FORCED
  EXPIRED
}

model UserSession {
  id String @id @default(cuid())

  // Identity
  username String
  role     String?

  // Network info (both sides)
  clientIp  String? // browser/client IP
  serverIp  String? // server/origin IP (from headers)
  hostname  String? // resolved hostname if available
  userAgent String? // full UA string

  // Timing
  loginTime   DateTime  @default(now())
  logoutTime  DateTime?
  durationMin Int? // filled on logout

  // State
  isActive     Boolean                  @default(true)
  logoutReason UserSessionLogoutReason?

  // Extra metadata (JSON string)
  // e.g. { "browser": "Chrome", "os": "Ubuntu", "country": "IN" }
  metadata String?

  @@index([username])
  @@index([loginTime])
  @@index([isActive])
  @@index([clientIp])
  @@map("user_sessions")
}

// ─────────────────────────────────────────
// Notices / News Room
// Admin-managed announcements shown on dashboard
// ─────────────────────────────────────────

enum NoticeType {
  INFO
  WARNING
  SUCCESS
  UPDATE
}

model Notice {
  id        Int        @id @default(autoincrement())
  title     String
  content   String
  type      NoticeType @default(INFO)
  isPinned  Boolean    @default(false)
  isActive  Boolean    @default(true)
  createdBy String?
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  expiresAt DateTime? // auto-hide after this date (null = permanent)

  @@index([isActive])
  @@index([isPinned])
  @@index([createdAt])
  @@map("notices")
}

model guacamole_user_available_ip {
  id         Int     @id @default(autoincrement())
  ip         String  @db.VarChar(256)
  group_name String  @db.VarChar(128)
  gateway    String? @db.VarChar(256)

  user_id  Int?
  username String? @db.VarChar(128)

  start_date DateTime? @db.Timestamp(0)

  is_available_user Int @default(0)

  connection_id  Int?
  container_name String? @db.VarChar(128)

  @@index([user_id], map: "idx_guacamole_user_available_ip_user_id")
  @@index([group_name], map: "idx_guacamole_user_available_ip_group_name")
  @@index([ip], map: "idx_guacamole_user_available_ip_ip")
}

